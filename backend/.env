# ===========================================
# IoT Device Manager - Backend Configuration
# ===========================================

# Server
PORT=4000
NODE_ENV=production

# Database (PostgreSQL) - matches docker-compose
DATABASE_URL="postgresql://iot_user:iot_password@postgres:5432/iot_devices"

# Redis
REDIS_URL="redis://redis:6379"

# JWT Authentication
JWT_SECRET="change-this-to-a-very-long-random-string-at-least-32-characters"
JWT_EXPIRES_IN="7d"

# MQTT Broker
MQTT_BROKER_URL="mqtt://mosquitto:1883"

# CORS (the nginx proxy handles this, but for local dev)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:80"
